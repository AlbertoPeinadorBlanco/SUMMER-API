# ──────────────────────────────────────────────────────────────────
# SurfMarket API — Production Environment Variables
# Copy this file to .env.production and fill in EVERY value.
# NEVER commit .env.production to git.
# ──────────────────────────────────────────────────────────────────

# ── Database (set by Docker Compose environment, override here if needed) ──
DB_HOST=db
DB_PORT=3306
DB_USER=surf_dev
DB_PASSWORD=secure_dev_password
DB_NAME=surfing_db

# ── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Your production domain (no trailing slash) ──────────────────────
FRONTEND_URL=https://yourdomain.com

# ── JWT Secrets ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_generate_a_new_64byte_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_64byte_hex_secret

# ── Sentry (optional — leave blank to disable) ──────────────────────
SENTRY_DSN=
